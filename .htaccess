# ============================
# AMHEEX - EXECUÇÃO PHP GLOBAL
# ============================

RewriteEngine On

# ============================
# FORÇA FRONT CONTROLLER
# ============================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

# ============================
# EXECUTA PHP EM TODAS AS REQUISIÇÕES
# (INCLUI QUALQUER PÁGINA)
# ============================
php_value auto_prepend_file "protection.php"

# ============================
# SEGURANÇA: BLOQUEIO DE ARQUIVOS
# ============================
<FilesMatch "(\.env|config\.php|db\.php|composer\.json|\.git|\.htaccess|\.htpasswd)$">
    Require all denied
</FilesMatch>

<Files ~ "\.(bak|old|sql|swp|~)$">
    Require all denied
</Files>

# ============================
# DESATIVA LISTAGEM DE DIRETÓRIO
# ============================
Options -Indexes

# ============================
# LIMITES PHP
# ============================
php_value upload_max_filesize 3072M
php_value post_max_size 3072M
php_value memory_limit 3072M
php_value max_execution_time 86400
php_value max_input_time 86400