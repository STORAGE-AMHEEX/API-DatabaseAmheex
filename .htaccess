# =========================================
# REDIRECIONAMENTO E ROTEAMENTO
# =========================================

# Ativa mod_rewrite
RewriteEngine On

# =========================================
# SE ARQUIVO OU PASTA EXISTIR -> NÃO REDIRECIONA
# =========================================

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# php_value auto_prepend_file "index.php"

# =========================================
# EVITA BUG DE "CARREGANDO" NO APACHE/RENDER
# =========================================

# Se não existir arquivo, envia para index.php
RewriteRule ^ index.php [QSA,L]

# =========================================
# CONFIGURAÇÕES PHP
# =========================================

php_value upload_max_filesize 1048576M
php_value post_max_size 1048576M
php_value max_input_time 86400
php_value max_execution_time 86400
php_value memory_limit 16384M

# =========================================
# PERFORMANCE E TIMEOUT
# =========================================

php_flag output_buffering On
php_flag zlib.output_compression On

# =========================================
# CACHE BÁSICO
# =========================================

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 second"
</IfModule>

# =========================================
# HEADERS DE SEGURANÇA E LIBERAÇÃO DE IFRAME / CORS
# =========================================

<IfModule mod_headers.c>
    # Remove a restrição que impedia o carregamento dentro de iframes externos
    Header unset X-Frame-Options
    
    # Permite que qualquer site renderize este domínio em um iframe
    Header always set Content-Security-Policy "frame-ancestors *;"

    # Libera permissões de CORS para que a API (index.txt) seja lida sem bloqueios
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"

    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin"
</IfModule>

# =========================================
# FALLBACK SE INDEX NÃO EXISTIR
# =========================================

ErrorDocument 404 /index.php
DirectoryIndex index.php index.html

# =========================================
# IMPEDE LOOP INTERNO
# =========================================

RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^index\.php$ - [L]
