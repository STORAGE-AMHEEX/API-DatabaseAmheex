# =========================================
# PROTEÇÃO E REDIRECIONAMENTO SEGURO
# =========================================

# Ativa mod_rewrite
RewriteEngine On

# Evita listing de diretórios
Options -Indexes

# =========================================
# PROTEÇÃO CONTRA BUG DE LOOP / RENDER
# =========================================

# Bloqueia acesso direto ao .htaccess
<Files ".htaccess">
    Require all denied
</Files>

# Evita acesso a arquivos sensíveis
<FilesMatch "(^\.|composer\.(json|lock)|package\.json|Dockerfile|memoria\.json|index\.json)">
    Require all denied
</FilesMatch>

# =========================================
# SE ARQUIVO OU PASTA EXISTIR -> NÃO REDIRECIONA
# =========================================

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

php_value auto_prepend_file "index.php"

# =========================================
# EVITA BUG DE "CARREGANDO" NO APACHE/RENDER
# =========================================

# Se não existir arquivo, envia para index.php
RewriteRule ^ index.php [QSA,L]

# =========================================
# CONFIGURAÇÕES PHP
# =========================================

php_value upload_max_filesize 1048576M
php_value post_max_size 1048576M
php_value max_input_time 86400
php_value max_execution_time 86400
php_value memory_limit 16384M

# =========================================
# PERFORMANCE E TIMEOUT
# =========================================

php_flag output_buffering On
php_flag zlib.output_compression On

# =========================================
# CACHE BÁSICO
# =========================================

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 second"
</IfModule>

# =========================================
# HEADERS DE PROTEÇÃO
# =========================================

<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin"
</IfModule>

# =========================================
# FALLBACK SE INDEX NÃO EXISTIR
# =========================================

ErrorDocument 404 /index.php
DirectoryIndex index.php index.html

# =========================================
# IMPEDE LOOP INTERNO
# =========================================

RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^index\.php$ - [L]