RewriteEngine On

# Front controller
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

# Bloqueio de arquivos sensíveis
<FilesMatch "(^\.|config\.php|db\.php|composer\.json|\.env|\.git|\.htaccess)$">
    Require all denied
</FilesMatch>

# Desativar listagem
Options -Indexes