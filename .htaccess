RewriteEngine On

# Impede o acesso direto ao seu arquivo de domínios
<Files "dominios.json">
    Order allow,deny
    Deny from all
</Files>

# Se for uma tentativa de Upload (ex: upload.php ou pasta /uploads)
# O Apache redireciona internamente para validar antes
RewriteCond %{REQUEST_URI} ^/up [NC]
RewriteRule .* protection.php [L]
