Options -Indexes
ServerSignature Off

RewriteEngine On
RewriteBase /

# tudo passa pelo PHP
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

# bloqueio de bots
RewriteCond %{HTTP_USER_AGENT} (HTTrack|Wget|curl|python|nikto|sqlmap|scan) [NC]
RewriteRule .* - [F,L]

# arquivos sensíveis
<FilesMatch "\.(env|log|ini|sh|sql|bak|git|htaccess)$">
    Require all denied
</FilesMatch>