# =========================================================
# TACADINHAMOD - PROTEÇÃO ULTRA (DOMÍNIOS FIXOS)
# =========================================================

Options -Indexes
ServerSignature Off

RewriteEngine On
RewriteBase /

# 1. WHITELIST DE DOMÍNIOS (ÚNICOS PERMITIDOS)
RewriteCond %{HTTP_HOST} !^(amheex\.web\.app|amheex\.com|api-amheex\.vercel\.app|api-amheex\.onrender\.com|localhost)$ [NC]
RewriteRule ^ - [F,L]

# 2. RESPOSTA SECA (PÁGINA BRANCA)
ErrorDocument 403 " "
ErrorDocument 404 " "
ErrorDocument 500 " "

# 3. ARQUIVOS DIRETOS
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]

RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# fallback
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

# 4. SEGURANÇA DE HEADERS
Header always set X-Frame-Options "SAMEORIGIN"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "no-referrer"

# CSP corrigido (mesmos domínios da whitelist)
Header always set Content-Security-Policy "default-src 'self' https://amheex.web.app https://amheex.com https://api-amheex.vercel.app https://api-amheex.onrender.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; img-src * data: blob:; connect-src *;"

# 5. BLOQUEIO DE REFERER (corrigido)
RewriteCond %{HTTP_REFERER} !^$
RewriteCond %{HTTP_REFERER} !^https?://(www\.)?(amheex\.web\.app|amheex\.com|api-tacadinhamod\.vercel\.app|api-amheex\.onrender\.com) [NC]
RewriteRule .* - [F,L]

# 6. BLOQUEIO DE BOT/SCAN
RewriteCond %{HTTP_USER_AGENT} (HTTrack|Wget|curl|python|nikto|sqlmap|scan) [NC]
RewriteRule .* - [F,L]

# 7. ARQUIVOS SENSÍVEIS
<FilesMatch "\.(env|log|ini|sh|sql|bak|json|yml|lock|git|htaccess)$">
    Require all denied
</FilesMatch>